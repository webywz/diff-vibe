# Optional. When set, diff-vibe drafts with an API and falls back
# to the offline heuristic if the request fails. Never required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Default vibe when --vibe is omitted: calm | punchy | dry
DIFF_VIBE_VIBE=calm
